{
  "name": "Polier-Pilot Dev",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.dev.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Polier-Pilot API",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -e '.[dev]' && cp -n .env.example .env || true",
  "postStartCommand": "alembic upgrade head 2>/dev/null || echo 'run: alembic upgrade head once .env is filled in'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },
  "remoteUser": "root"
}
