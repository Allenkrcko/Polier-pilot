# =====================================================
# Polier-Pilot - environment variables
# Copy to .env and fill with real values for local dev.
# =====================================================

# --- App ---
APP_ENV=development               # development | staging | production
APP_NAME=polier-pilot
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
TIMEZONE=Europe/Berlin

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
SECRET_KEY=replace-with-random-secret

# --- Database ---
# In docker-compose use host=postgres; locally outside docker use localhost
DATABASE_URL=postgresql+asyncpg://polier:polier@postgres:5432/polier
DATABASE_URL_SYNC=postgresql+psycopg2://polier:polier@postgres:5432/polier
POSTGRES_USER=polier
POSTGRES_PASSWORD=polier
POSTGRES_DB=polier

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0

# --- Twilio (WhatsApp Business API) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number
TWILIO_WEBHOOK_VALIDATE=true                  # verify X-Twilio-Signature

# --- OpenAI (Whisper STT) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_WHISPER_MODEL=whisper-1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL_GENERATION=claude-sonnet-4-5
ANTHROPIC_MODEL_CLASSIFICATION=claude-haiku-4-5

# --- Storage ---
STORAGE_BACKEND=local             # local | s3
STORAGE_LOCAL_PATH=/app/storage
# S3 / Hetzner Object Storage (later)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-central

# --- Email (Phase 6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@polier-pilot.de

# --- Weather (Open-Meteo, no key needed) ---
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# --- Retention (DSGVO) ---
RAW_AUDIO_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=730        # 2 years VOB
